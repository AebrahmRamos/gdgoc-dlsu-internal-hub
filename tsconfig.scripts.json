{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ES2020",
    "moduleResolution": "node",
    "target": "ES2020",
    "lib": ["ES2020"],
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "outDir": "./dist/scripts",
    "rootDir": ".",
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["scripts/**/*", "src/types/**/*"],
  "exclude": ["node_modules", "dist"]
}
